---
import '../styles/tokens.css';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import { business } from '../data/business';
import { getAutoRepairSchema, getBreadcrumbSchema } from '../seo/jsonld';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  schemaJson?: any;
}

const { 
  title, 
  description, 
  canonicalPath = Astro.url.pathname,
  schemaJson 
} = Astro.props;

const canonicalUrl = `${business.siteUrl}${canonicalPath.endsWith('/') ? canonicalPath : canonicalPath + '/'}`;
const autoRepairSchema = getAutoRepairSchema();
const breadcrumbSchema = getBreadcrumbSchema(canonicalPath);
---

<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Favicon & Touch Icon -->
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="apple-touch-icon" href="/images/logo.png" />
    <meta name="theme-color" content="#16212C" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${business.siteUrl}/images/logo.png`} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${business.siteUrl}/images/logo.png`} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(autoRepairSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {schemaJson && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />
    )}
  </head>
  <body>
    <TopBar />
    <Header currentPath={canonicalPath} />
    
    <main id="main-content">
      <slot />
    </main>

    <Footer />
    <MobileActionBar />
  </body>
</html>
