---
import '../styles/tokens.css';
import { business } from '../data/business';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: object | object[];
}

const { title, description, canonical = business.siteUrl, schema } = Astro.props;
const currentUrl = canonical;
---

<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={currentUrl} />
  <meta name="theme-color" content="#16212C" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={currentUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${business.siteUrl}/images/logo.png`} />
  <meta property="og:locale" content="tr_TR" />
  <meta property="og:site_name" content={business.serviceBrand} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${business.siteUrl}/images/logo.png`} />

  <!-- Icons -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />

  <!-- Fonts preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />

  <!-- Schema.org JSON-LD -->
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}
</head>
<body>
  <a href="#ana-icerik" class="skip-link">İçeriğe Geç</a>
  <slot />

  <style>
    .skip-link {
      position: absolute;
      top: -100px;
      left: 16px;
      background: var(--accent);
      color: #fff;
      padding: 10px 16px;
      font-weight: 700;
      border-radius: var(--radius-button);
      z-index: 9999;
      transition: top 0.2s ease;
    }
    .skip-link:focus {
      top: 16px;
    }
  </style>
</body>
</html>
