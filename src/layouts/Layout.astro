---
import { business } from '../data/business';
import '../styles/theme.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "İzmir Yağ Değişimi & Periyodik Bakım | ASM Auto Servis",
  description = "İzmir'de 25 yıldır aynı adreste motor yağı ve filtre değişimine odaklanan, Murat Asım ustalığıyla araç üretici onaylı sentetik yağlar ve orijinal filtrelerle profesyonel periyodik servis.",
  canonical = business.siteUrl
} = Astro.props;
---

<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, minimum-scale=1, maximum-scale=5" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href="/images/logo.png" />
  <link rel="apple-touch-icon" href="/images/logo.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#b90809" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

  <!-- OpenGraph & Twitter Card -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="tr_TR" />
  <meta property="og:site_name" content={business.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://izmiryagdegisimi.web.app/images/oil-fill-hero.webp" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://izmiryagdegisimi.web.app/images/oil-fill-hero.webp" />

  <!-- GEO-Targeting & Local SEO Engine (İzmir / Gaziemir) -->
  <meta name="geo.region" content="TR-35" />
  <meta name="geo.placename" content="İzmir, Gaziemir" />
  <meta name="geo.position" content="38.3182;27.1354" />
  <meta name="ICBM" content="38.3182, 27.1354" />

  <!-- Syndication & Protocol Links (RSS, Atom, JSON Feed) -->
  <link rel="alternate" type="application/rss+xml" title="ASM Auto RSS 2.0 Feed" href="https://izmiryagdegisimi.web.app/rss.xml" />
  <link rel="alternate" type="application/atom+xml" title="ASM Auto Atom Feed" href="https://izmiryagdegisimi.web.app/atom.xml" />
  <link rel="alternate" type="application/json" title="ASM Auto JSON Feed" href="https://izmiryagdegisimi.web.app/feed.json" />

  <!-- 14KB FIRST-PACKET COMPREHENSIVE @graph JSON-LD (MANDATE V9.0) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "AutoRepair",
        "@id": "https://izmiryagdegisimi.web.app/#autorepair",
        "name": business.name,
        "alternateName": "İzmir Yağ Değişimi",
        "image": "https://izmiryagdegisimi.web.app/images/logo.png",
        "telephone": business.phoneE164,
        "email": business.email,
        "url": business.siteUrl,
        "priceRange": "₺₺",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": business.address.street,
          "addressLocality": "Gaziemir",
          "addressRegion": "İzmir",
          "postalCode": "35410",
          "addressCountry": "TR"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 38.3182,
          "longitude": 27.1354
        },
        "hasMap": business.address.googleMapsUrl,
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
            "opens": "08:30",
            "closes": "19:00"
          }
        ],
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.9",
          "bestRating": "5",
          "worstRating": "1",
          "ratingCount": "54"
        },
        "founder": {
          "@type": "Person",
          "name": "Murat Asım",
          "jobTitle": "Baş Teknisyen & Kurucu"
        },
        "sameAs": [
          "https://www.wikidata.org/wiki/Q11589432",
          business.social.instagramShop,
          business.social.instagramMaster
        ]
      },
      {
        "@type": "WebSite",
        "@id": "https://izmiryagdegisimi.web.app/#website",
        "url": "https://izmiryagdegisimi.web.app",
        "name": "ASM Auto İzmir Yağ Değişimi",
        "publisher": { "@id": "https://izmiryagdegisimi.web.app/#autorepair" },
        "inLanguage": "tr-TR"
      },
      {
        "@type": "WebPage",
        "@id": `${canonical}#webpage`,
        "url": canonical,
        "name": title,
        "description": description,
        "isPartOf": { "@id": "https://izmiryagdegisimi.web.app/#website" },
        "about": { "@id": "https://izmiryagdegisimi.web.app/#autorepair" },
        "inLanguage": "tr-TR",
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [".hero-title", ".hero-desc", ".concerns-header", ".hero-hud-card"]
        }
      }
    ]
  })} />
</head>
<body>

  <!-- 1. ÜST BİLGİ BANDI (TEK SIRA, TEK NUMARA: +90 532 555 00 99) -->
  <div id="Action_bar">
    <div class="container">
      <div class="action-bar-left">
        <span class="slogan">25 Yıldır Aynı Adreste | ASM Auto İzmir Yağ Servisi</span>
        <div class="contact-item">
          <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
          <a href={`tel:${business.phoneE164}`}><strong>{business.phoneDisplay}</strong></a>
        </div>
        <div class="contact-item">
          <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          <a href={`mailto:${business.email}`}>{business.email}</a>
        </div>
      </div>
      <div class="action-bar-right">
        <div class="social-links">
          <a href={business.social.instagramMaster} target="_blank" rel="noopener noreferrer" aria-label="Murat Asım Instagram" title="Murat Asım Instagram">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href={business.social.instagramShop} target="_blank" rel="noopener noreferrer" aria-label="ASM Auto Atölye" title="ASM Auto Atölye">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. ANA BAŞLIK VE MENÜ (KESİNTİSİZ TEK SIRA, SIFIR TAŞMA) -->
  <header id="Top_bar">
    <div class="container">
      
      <!-- Sol: Şeffaf Krom Logo -->
      <a href="/" class="header-logo-wrap" title="ASM İzmir Yağ Değişim Servisi">
        <img src="/images/logo.png" alt="İzmir Yağ Değişim Servisi ASM Auto" width="200" height="68" />
      </a>

      <!-- Orta: Tek Sıra Navigasyon -->
      <nav aria-label="Ana Menü">
        <ul class="main-nav">
          <li><a href="/">Anasayfa</a></li>
          <li><a href="/hakkimizda/">Hakkımızda</a></li>
          <li><a href="/ustalik-ve-kalite/">Standartlarımız</a></li>
          <li><a href="/motor-yagi-degisimi/">Hizmetlerimiz</a></li>
          <li><a href="/sikca-sorulan-sorular/">Soru & Cevap</a></li>
          <li><a href="/iletisim/">İletişim & Konum</a></li>
        </ul>
      </nav>

      <!-- Sağ: Hızlı Çağrı / Randevu Eylemi -->
      <div class="header-right-action">
        <a href="#servis-talebi" class="header-cta-btn">
          <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/></svg>
          Randevu Al
        </a>
        <button class="mobile-menu-toggle" aria-label="Menüyü Aç" onclick="document.querySelector('.main-nav').classList.toggle('mobile-open')">
          ☰
        </button>
      </div>

    </div>
  </header>

  <!-- SAYFA İÇERİĞİ -->
  <main>
    <slot />
  </main>

  <!-- ALT BÖLÜM -->
  <footer id="Footer">
    <div class="container">
      <div class="footer-grid">
        <!-- Kolon 1 -->
        <div class="footer-col">
          <img src="/images/logo.png" alt="ASM Yağ Değişim Servisi" class="footer-logo" />
          <p style="font-size: 13.5px; line-height: 1.7; margin-bottom: 16px;">
            Murat Asım liderliğinde İzmir 6. Sanayi Sitesi'nde 25 yıldır aynı adreste motor yağı değişimi, motor revizyonu ve periyodik araç bakımı sunuyoruz.
          </p>
          <div class="social-links" style="display: flex; gap: 8px;">
            <a href={business.social.instagramMaster} target="_blank" rel="noopener noreferrer" aria-label="Murat Asım Instagram" title="Murat Asım">
              <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a href={business.social.instagramShop} target="_blank" rel="noopener noreferrer" aria-label="ASM Auto Atölye" title="ASM Auto Atölye">
              <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
          </div>
        </div>

        <!-- Kolon 2 -->
        <div class="footer-col">
          <h4>Hizmetlerimiz</h4>
          <ul>
            <li><a href="/motor-yagi-degisimi/">→ Motor Yağı Değişimi</a></li>
            <li><a href="/yag-filtresi-degisimi/">→ Yağ Filtresi Değişimi</a></li>
            <li><a href="/periyodik-bakim/">→ Periyodik Bakım Paketi</a></li>
            <li><a href="/ustalik-ve-kalite/">→ Ustalık & Standartlarımız</a></li>
            <li><a href="/motor-yagi-degisimi/">→ Ticari & Filo Bakımı</a></li>
          </ul>
        </div>

        <!-- Kolon 3 -->
        <div class="footer-col">
          <h4>Konum & Saatler</h4>
          <p style="font-size: 13.5px; line-height: 1.6; margin-bottom: 12px;">
            {business.address.fullAddress}
          </p>
          <p style="font-size: 13px; color: #cbd5e1; margin-bottom: 6px;">
            <strong>Pzt - Cmt:</strong> {business.workingHours.weekdays}
          </p>
          <p style="font-size: 13px; color: #cbd5e1; margin-bottom: 12px;">
            <strong>Pazar:</strong> {business.workingHours.sunday}
          </p>
          <a href={business.address.googleMapsUrl} target="_blank" rel="noopener noreferrer" style="color: #ff4d4f; font-weight: 700; font-size: 13px;">
            Google Haritalarda Aç ↗
          </a>
        </div>

        <!-- Kolon 4 -->
        <div class="footer-col">
          <h4>İletişim & Randevu</h4>
          <p style="font-size: 15px; font-weight: 800; color: #fff; margin-bottom: 8px;">
            Telefon: <a href={`tel:${business.phoneE164}`} style="color: #ff4d4f;">{business.phoneDisplay}</a>
          </p>
          <p style="font-size: 13.5px; margin-bottom: 16px;">
            E-Posta: {business.email}
          </p>
          <a href="#servis-talebi" class="header-cta-btn" style="display: block; text-align: center;">
            Hemen Talep Oluştur
          </a>
        </div>
      </div>

      <!-- KURUMSAL ÇAPRAZ PENETRASYON VE ANALİTİK KARAR DESTEK AĞI -->
      <div class="footer-partners-strip" style="border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 16px; margin-top: 20px; font-size: 11.5px; color: #64748b; line-height: 1.6;">
        <span style="color: #94a3b8; font-weight: 700;">Bağlı Karar Destek & Analitik Ağ Platformları:</span>
        <div style="display: flex; flex-wrap: wrap; gap: 8px 14px; margin-top: 6px;">
          <a href="https://drfin.com.tr" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: none;" title="Kurumsal Finansal Analiz">drfin.com.tr</a> •
          <a href="https://excelarsiv.com" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: none;" title="Karar Modelleri & Arşiv">excelarsiv.com</a> •
          <a href="https://skdmhesapla.com" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: none;" title="SKDM Emisyon Hesaplama">skdmhesapla.com</a> •
          <a href="https://karbonfiyat.com" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: none;" title="Yeşil Dönüşüm & MoYDeN">karbonfiyat.com</a> •
          <a href="https://inversioncore.com" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: none;" title="Sistem Mimari Modelleri">inversioncore.com</a> •
          <a href="https://belginkuyumculuk.com" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: none;" title="Değerleme Standartları">belginkuyumculuk.com</a> •
          <a href="https://saatchi.com.tr" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: none;" title="Tasarım Mühendisliği">saatchi.com.tr</a> •
          <a href="https://dilekceyazdir.com.tr" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: none;" title="Tüketici Hakları Rehberi">dilekceyazdir.com.tr</a> •
          <a href="https://htmlandhtml.com" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: none;" title="Semantik Web Standartları">htmlandhtml.com</a> •
          <a href="https://degerlet.com" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: none;" title="Araç & Varlık Değerleme">degerlet.com</a>
        </div>
      </div>

      <div class="footer-bottom" style="margin-top: 14px;">
        <p>© 2026 {business.name}. Tüm Hakları Saklıdır. | <a href="/ustalik-ve-kalite/">Hizmet ve Kalite İlkelerimiz</a> | <a href="/kvkk-aydinlatma/">KVKK Aydınlatma</a> | <a href="/gizlilik-ve-cerezler/">Gizlilik & Çerez Politikası</a></p>
      </div>
