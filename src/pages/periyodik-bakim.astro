---
import Layout from '../layouts/Layout.astro';
import { business } from '../data/business';
---

<Layout
  title="İzmir Periyodik Araç Bakımı | ASM Auto Servis"
  description="İzmir'de 10.000 ve 15.000 km periyodik araç bakımı. Yağ, filtreler, sıvı seviyeleri ve 30 nokta güvenlik analizi."
>
  <div style="background-color: var(--amcam-dark); color: #fff; padding: 45px 0 50px; border-bottom: 3px solid var(--amcam-red);">
    <div class="container">
      <span class="section-tag" style="color: #ff4d4f;">TAM SERVİS PAKETİ</span>
      <h1 style="font-size: 36px; color: #fff; text-transform: uppercase;">Periyodik Bakım Hizmeti</h1>
      <p style="color: #cbd5e1; font-size: 16px; margin-top: 8px;">Aracınızın güvenliği ve sürüş konforu için eksiksiz periyodik kontrol paketi.</p>
    </div>
  </div>

  <section style="padding: 60px 0; background-color: #fff;">
    <div class="container">
      <div class="about-grid">
        <div>
          <img src="/images/service-periodic.webp" alt="Periyodik Bakım Paketi" style="border-radius: 4px; box-shadow: 0 8px 24px rgba(0,0,0,0.1); border: 1px solid #e2e8f0;" />
        </div>
        <div>
          <span class="section-tag">30 NOKTA KONTROL</span>
          <h2 class="section-title">Periyodik Bakım Kapsamımız</h2>
          <p class="about-lead">
            Sadece yağ değil; motorun, frenlerin ve yürüyen aksamın sağlığı için tam entegre servis sunuyoruz.
          </p>
          <ul class="about-checklist" style="margin-top: 20px;">
            <li>✓ Motor Yağı & Yağ Filtresi</li>
            <li>✓ Hava & Polen Filtresi Değişimi</li>
            <li>✓ Fren Balata & Disk Kalınlık Ölçümü</li>
            <li>✓ Fren Hidroliği Nem Testi</li>
            <li>✓ Antifriz Donma Derecesi Ölçümü</li>
            <li>✓ Alt Takım & Süspansiyon Kontrolü</li>
          </ul>
          <div style="margin-top: 25px;">
            <a href="/#servis-talebi" class="header-cta-btn">Randevu Al & Fiyat Sor →</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
