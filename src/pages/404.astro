---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Sayfa Bulunamadı (404) | ASM Auto İzmir" 
  description="Aradığınız sayfa taşınmış veya silinmiş olabilir."
  canonicalPath="/404/"
>
  <section class="section error-section">
    <div class="container error-box">
      <span class="error-badge">404 HATA</span>
      <h1>Sayfa Bulunamadı</h1>
      <p>Aradığınız sayfa mevcut değil veya taşınmış olabilir. Anasayfamıza dönerek motor yağı değişimi ve servis hizmetlerimize göz atabilirsiniz.</p>
      <div class="error-actions">
        <a href="/" class="btn btn-primary">Anasayfaya Dön</a>
        <a href="/randevu/" class="btn btn-secondary">Randevu Al</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-section {
    padding: 80px 0;
    text-align: center;
  }
  .error-box {
    max-width: 600px;
    margin: 0 auto;
  }
  .error-badge {
    display: inline-block;
    font-size: 14px;
    font-weight: 800;
    background-color: var(--error-bg);
    color: var(--error);
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 16px;
  }
  .error-box h1 {
    font-size: 36px;
    margin-bottom: 16px;
  }
  .error-box p {
    font-size: 16px;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 28px;
  }
  .error-actions {
    display: flex;
    gap: 14px;
    justify-content: center;
  }
</style>
