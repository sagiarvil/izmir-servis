---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationForm from '../components/LocationForm.astro';
import { seoRegistry } from '../seo/registry';

const seo = seoRegistry['/iletisim/'];
---

<BaseLayout 
  title={seo.title} 
  description={seo.description}
  canonicalPath="/iletisim/"
>
  <div class="page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Sayfa Konumu">
        <a href="/">Anasayfa</a>
        <span>/</span>
        <span class="current">İletişim & Konum</span>
      </nav>
      <h1 class="page-title">{seo.heading}</h1>
      <p class="page-intro">
        ASM Auto atölye adresimiz, harita konumu, sabit ve mobil iletişim numaralarımız ile bize dilediğiniz zaman ulaşabilirsiniz.
      </p>
    </div>
  </div>

  <LocationForm />
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #16212C 0%, #0F1722 100%);
    color: #FFFFFF;
    padding: 48px 0;
    border-bottom: 2px solid var(--accent);
  }
  .breadcrumb {
    display: flex;
    gap: 8px;
    font-size: 13px;
    color: #94A3B8;
    margin-bottom: 16px;
  }
  .breadcrumb a {
    color: #CBD5E1;
  }
  .breadcrumb .current {
    color: #FFA573;
    font-weight: 600;
  }
  .page-title {
    color: #FFFFFF;
    font-size: 32px;
    margin-bottom: 12px;
  }
  .page-intro {
    font-size: 16px;
    color: #94A3B8;
    max-width: 720px;
    line-height: 1.6;
  }
</style>
