  <!-- İSTATİSTİK SAYACI DÖNME VE OTURMA ANİMASYONU (INTERSECTION OBSERVER) -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const statsSection = document.getElementById('stats-section');
      if (!statsSection) return;

      let animated = false;

      const formatNumber = (num, format) => {
        if (format === 'thousands') {
          return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
        }
        return num.toString();
      };

      const runCounterAnimation = () => {
        if (animated) return;
        animated = true;

        const counters = statsSection.querySelectorAll('.stat-counter');
        const duration = 2000; // 2 saniye akıcı dönüş
        const startTime = performance.now();

        const targets = Array.from(counters).map(counter => {
          const target = parseInt(counter.getAttribute('data-target') || '0', 10);
          const format = counter.getAttribute('data-format') || 'standard';
          const valEl = counter.querySelector('.counter-val');
          return { el: valEl, target, format };
        });

        const update = (now) => {
          const elapsed = now - startTime;
          const progress = Math.min(elapsed / duration, 1);
          // easeOutExpo formülü: hızlı başlayıp hedefe pürüzsüzce oturur
          const easeProgress = progress === 1 ? 1 : 1 - Math.pow(2, -10 * progress);

          targets.forEach(item => {
            if (item.el) {
              const currentVal = Math.floor(easeProgress * item.target);
              item.el.textContent = formatNumber(currentVal, item.format);
            }
          });

          if (progress < 1) {
            requestAnimationFrame(update);
          } else {
            // Son tam değere oturt
            targets.forEach(item => {
              if (item.el) {
                item.el.textContent = formatNumber(item.target, item.format);
              }
            });
          }
        };

        requestAnimationFrame(update);
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            runCounterAnimation();
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.2 });

      observer.observe(statsSection);
    });
  </script>

