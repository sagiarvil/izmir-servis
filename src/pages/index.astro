---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCards from '../components/ServiceCards.astro';
import WhyUs from '../components/WhyUs.astro';
import AboutMaster from '../components/AboutMaster.astro';
import CtaBanner from '../components/CtaBanner.astro';
import FaqSection from '../components/FaqSection.astro';
import LocationForm from '../components/LocationForm.astro';
import { seoRegistry } from '../seo/registry';

const seo = seoRegistry['/'];
---

<BaseLayout 
  title={seo.title} 
  description={seo.description}
  canonicalPath="/"
>
  <!-- S02: Hero Section -->
  <Hero />

  <!-- S03: Hızlı Hizmet Seçimi & Amcam Tarzı Servis Kartları -->
  <ServiceCards />

  <!-- S04: Neden ASM? Atölye ve İşlem Adımları -->
  <WhyUs />

  <!-- S05: Usta Murat & 35 Yıllık Ustalık Deneyimi -->
  <AboutMaster />

  <!-- S06: Hızlı Randevu & Telefon Bandı -->
  <CtaBanner />

  <!-- S07: Araç Bakım Rehberi & Sıkça Sorulan Sorular -->
  <FaqSection />

  <!-- S08: Tek Gerçek Konum & Çevrimiçi Servis Talebi Formu -->
  <LocationForm />
</BaseLayout>
