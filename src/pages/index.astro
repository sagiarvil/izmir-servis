---
import Layout from '../layouts/Layout.astro';
import { business } from '../data/business';
import { googleReviews } from '../data/reviews';

const row1 = googleReviews.slice(0, 27);
const row2 = googleReviews.slice(27, 54);
---

<Layout
  title="İzmir Yağ Değişimi & Periyodik Bakım Servisi | ASM Auto"
  description="İzmir'de 25 yıldır aynı adreste motor yağı ve filtre değişimine odaklanan, Murat Asım ustalığıyla araç üretici onaylı sentetik yağlar ve orijinal filtrelerle profesyonel periyodik servis."
>

  <!-- =========================================================================
       ANA SLAYT / TANITIM BANDI
       ========================================================================= -->
  <!-- =========================================================================
       ANA SLAYT / TANITIM BANDI (2050 YENİ NESİL SİNEMATİK TAM GENİŞLİK)
       ========================================================================= -->
  <section class="hero-slider-wrap">
    <!-- Full-Width Sinematik Arka Plan Görseli -->
    <div class="hero-bg-media">
      <img 
        src="/images/oil-fill-hero.webp" 
        alt="İzmir Motor Yağı Değişimi ve Doldurma İşlemi" 
        width="1920" 
        height="1080" 
        loading="eager"
      />
    </div>

    <div class="container" style="position: relative; z-index: 3;">
      <div class="hero-grid-2050">
        
        <!-- Sol: Uçarak Gelen Başlık ve İçerik -->
        <div class="hero-content">
          <div class="hero-badge-anim">
            <span class="hero-badge">25 Yıldır Aynı Adreste | İzmir Motor Yağı Merkezi</span>
          </div>

          <h1 class="hero-title hero-title-anim">
            <span class="hero-word-fly fly-word-1">İZMİR</span>
            <span class="hero-word-fly fly-word-2">MOTOR</span>
            <span class="hero-word-fly fly-word-3">YAĞI</span>
            <span class="hero-word-fly fly-word-4">DEĞİŞİMİ</span>
            <span class="hero-accent-block">
              <span class="hero-word-fly fly-word-amp">&amp;</span>
              <span class="hero-word-fly fly-word-5">PERİYODİK</span>
              <span class="hero-word-fly fly-word-6">BAKIM</span>
            </span>
          </h1>

          <p class="hero-desc hero-desc-anim">
            Murat Asım'ın 25 yıllık atölye tecrübesi, araç üretici onaylı tam sentetik yağlar ve fabrika standartlarında orijinal filtrelerle motorunuzu ilk günkü performansında koruyun.
          </p>

          <div class="hero-actions hero-actions-anim">
            <a href="#servis-talebi" class="btn-hero-red">
              <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/></svg>
              Hemen Servis Randevusu Al
            </a>
            <a href={business.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-hero-whatsapp">
              <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/></svg>
              WhatsApp ile Fiyat Sor
            </a>
          </div>

          <div class="hero-highlights hero-highlights-anim">
            <span>✓ <strong>25 Yıllık Deneyim:</strong> 6. Sanayi Sitesi'nde aynı adreste</span>
            <span>✓ <strong>Araca Özel Spesifikasyon:</strong> Fabrika onaylı motor yağları</span>
            <span>✓ <strong>Orijinal Filtreler:</strong> MANN, Bosch, Filtron lisanslı</span>
          </div>
        </div>

        <!-- Sağ: 360 Derece Dönen Canlı Neon Çerçeveli Mıknatıs Kart -->
        <div class="hero-neon-box-wrap hero-hud-anim">
          <div class="hero-hud-card">
            <div class="hero-hud-header">
              <h3 class="hero-hud-title">İzmir'in Güvenilir Yağ Servisi</h3>
              <span class="hero-hud-meta">⚡ 25-35 DK HIZLI SERVİS</span>
            </div>
            
            <div class="hero-hud-items">
              <div class="hero-hud-row">
                <span>📍 25 Yıldır Aynı Adreste:</span>
                <strong style="color: #ff4d4f;">6. Sanayi Sitesi No:17</strong>
              </div>
              <div class="hero-hud-row">
                <span>🛡️ Göz Önünde Açılan Bidon:</span>
                <strong>%100 Orijinal Onaylı Yağ</strong>
              </div>
              <div class="hero-hud-row">
                <span>🔧 Tork Anahtarlı Montaj:</span>
                <strong style="color: #00e676;">25 Nm Sıfır Sızıntı Güvencesi</strong>
              </div>
              <div class="hero-hud-row">
                <span>📋 30 Nokta Kontrol:</span>
                <strong>Fren & Antifriz Analizi Hediye</strong>
              </div>
              <div class="hero-hud-row" style="border-left-color: #ffd600;">
                <span>💰 Net & Şeffaf Fiyat:</span>
                <strong style="color: #ffd600;">Sürpriz Maliyet Yok</strong>
              </div>
            </div>

            <!-- Kart İçi Doğrudan İletişim / Randevu Butonu -->
            <div style="margin-top: 18px; padding-top: 14px; border-top: 1px solid rgba(255, 255, 255, 0.1); display: flex; align-items: center; justify-content: space-between; gap: 10px;">
              <span style="font-size: 11.5px; color: #94a3b8;">Hemen Danış & Fiyat Al:</span>
              <a href="tel:+905325550099" style="background: var(--asm-red); color: #fff; font-size: 13px; font-weight: 800; padding: 8px 14px; border-radius: 4px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 4px 12px rgba(185, 8, 9, 0.4);">
                📞 +90 532 555 00 99
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       SÜRÜCÜ ENDİŞELERİ & ASM GÜVENCESİ (SANAYİ KAYGILARI - GÜVEN PROTOKOLÜ)
       ========================================================================= -->
  <section class="section-driver-concerns">
    <div class="container">
      
      <div class="concerns-header">
        <span class="section-tag" style="background: rgba(185, 8, 9, 0.08); color: var(--asm-red);">SANAYİ VE BAKIM ENDİŞELERİNE SON</span>
        <h2 class="section-title" style="margin-top: 8px;">Yağ Değişiminde Sürücüleri Rahatlatan 5 ASM Güvencesi</h2>
        <p style="color: var(--asm-text-muted); font-size: 15px; margin: 10px auto 0 auto; max-width: 720px; line-height: 1.6;">
          Araç sahiplerinin yağ değişiminde en çok tereddüt ettiği 5 kritik konuyu sanayi alışkanlıklarıyla değil, otomotiv mühendisliği disiplini ve atölye şeffaflığıyla çözüyoruz.
        </p>
      </div>

      <div class="concerns-grid">
        
        <!-- Kaygı 1 -->
        <div class="concern-card">
          <div class="concern-badge-row">
            <span class="concern-num">ENDİŞE 01</span>
            <span class="concern-icon">📖</span>
          </div>
          <div class="concern-problem">
            <span class="concern-problem-tag">Sürücü Tereddütü</span>
            <p class="concern-problem-title">"Ustaya mı güvenmeliyim, kitapçığa mı? Sahte yağ riski var mı?"</p>
          </div>
          <div class="concern-solution">
            <span class="concern-solution-tag">ASM Güvencesi</span>
            <h3 class="concern-solution-title">Fabrika Kitapçık Onayı & %100 Lisanslı Yağ</h3>
            <p class="concern-solution-text">
              Tahmini vizkozite kullanılmaz. Üretici onay koduna (MB 229.52, VW 504/507, RN 0720, BMW LL-04) göre kapalı jelatinli distribütör yağı gözünüzün önünde açılır.
            </p>
          </div>
          <div class="concern-footer-proof">
            <span>🛡️ Distribütör Faturalı Kapalı Ambalaj</span>
          </div>
        </div>

        <!-- Kaygı 2 -->
        <div class="concern-card">
          <div class="concern-badge-row">
            <span class="concern-num">ENDİŞE 02</span>
            <span class="concern-icon">👁️</span>
          </div>
          <div class="concern-problem">
            <span class="concern-problem-tag">Sürücü Tereddütü</span>
            <p class="concern-problem-title">"Yağı gerçekten değiştirdiler mi, eski yağın üstüne mi eklediler?"</p>
          </div>
          <div class="concern-solution">
            <span class="concern-solution-tag">ASM Güvencesi</span>
            <h3 class="concern-solution-title">Göz Önünde Karterden Sıcak Tahliye & Şeffaf Fiyat</h3>
            <p class="concern-solution-text">
              Araç lifte kalkar; eski yağın karterden son damlasına kadar akışını ve çıkan eski filtreyi yanımızda görürsünüz. İşlem öncesi net fiyat onaylanır, sürpriz çıkmaz.
            </p>
          </div>
          <div class="concern-footer-proof">
            <span>🔍 %100 Şeffaf Servis & Sabit Fiyat</span>
          </div>
        </div>

        <!-- Kaygı 3 -->
        <div class="concern-card">
          <div class="concern-badge-row">
            <span class="concern-num">ENDİŞE 03</span>
            <span class="concern-icon">⏱️</span>
          </div>
          <div class="concern-problem">
            <span class="concern-problem-tag">Sürücü Tereddütü</span>
            <p class="concern-problem-title">"Kilometre dolmadı ama 1 yıl geçti, değiştirmek zorunda mıyım?"</p>
          </div>
          <div class="concern-solution">
            <span class="concern-solution-tag">ASM Güvencesi</span>
            <h3 class="concern-solution-title">Viskozite Oksidasyon Testi & Net Yönlendirme</h3>
            <p class="concern-solution-text">
              Motor yağı çalışmasa dahi nem ve yakıt buharıyla oksitlenir. Yağ kalitesini optik ve viskozite kontrolüyle inceler, gerek yoksa boş yere masraf açtırmayız.
            </p>
          </div>
          <div class="concern-footer-proof">
            <span>📊 Bilimsel Analiz, Dürüst Esnaflık</span>
          </div>
        </div>

        <!-- Kaygı 4 -->
        <div class="concern-card">
          <div class="concern-badge-row">
            <span class="concern-num">ENDİŞE 04</span>
            <span class="concern-icon">⚙️</span>
          </div>
          <div class="concern-problem">
            <span class="concern-problem-tag">Sürücü Tereddütü</span>
            <p class="concern-problem-title">"Yağ filtresi her seferinde değişmeli mi, 2 bakımda 1 yeterli mi?"</p>
          </div>
          <div class="concern-solution">
            <span class="concern-solution-tag">ASM Güvencesi</span>
            <h3 class="concern-solution-title">İstisnasız Her Değişimde Yeni OEM Filtre</h3>
            <p class="concern-solution-text">
              Eski filtrede kalan 300-500 ml kirli çamurlu yağ yeni yağı 500 km içinde bozar. ASM'de her yağ değişiminde filtre ve karter tapası contası kural olarak sıfırlanır.
            </p>
          </div>
          <div class="concern-footer-proof">
            <span>🔄 Sıfır Kontaminasyon İlkesi</span>
          </div>
        </div>

        <!-- Kaygı 5 -->
        <div class="concern-card">
          <div class="concern-badge-row">
            <span class="concern-num">ENDİŞE 05</span>
            <span class="concern-icon">🔊</span>
          </div>
          <div class="concern-problem">
            <span class="concern-problem-tag">Sürücü Tereddütü</span>
            <p class="concern-problem-title">"Değişimden sonra karterden yağ damlar mı, motordan ses gelir mi?"</p>
          </div>
          <div class="concern-solution">
            <span class="concern-solution-tag">ASM Güvencesi</span>
            <h3 class="concern-solution-title">25 Nm Tork Anahtarı & Kaçak/Ses Testi</h3>
            <p class="concern-solution-text">
              Karter tapası ve filtre üretici tork değeriyle (25 Nm) sıkılır; yalama ve kaçak riski sıfırdır. Motor 5 dk çalıştırılıp hidrolik itici sesi ve sızdırmazlık onaylanarak teslim edilir.
            </p>
          </div>
          <div class="concern-footer-proof">
            <span>🔧 Tork Anahtarlı Kaçaksız Teslimat</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       3 DEĞER KUTUSU (DEĞERLERİMİZ / KALİTE / SÜRDÜRÜLEBİLİRLİK)
       ========================================================================= -->
  <section class="section-energy-boxes">
    <div class="container">
      <div class="energy-boxes-grid">
        
        <!-- Kutu 1 -->
        <div class="energy-box">
          <div class="energy-box-header">
            <div class="energy-box-num">1</div>
            <div class="energy-box-titles">
              <h2>Değerlerimiz</h2>
              <h3>Teknik Doğruluk & Onay</h3>
            </div>
          </div>
          <p class="energy-box-desc">
            Aracınızın motoruna rastgele yağ değil; üretici fabrika kılavuzundaki tam spesifikasyon (0W-20, 5W-30, 5W-40) onaylı sentetik motor yağını uyguluyoruz.
          </p>
        </div>

        <!-- Kutu 2 -->
        <div class="energy-box">
          <div class="energy-box-header">
            <div class="energy-box-num">2</div>
            <div class="energy-box-titles">
              <h2>Kalite Politikaları</h2>
              <h3>Müşteri Odaklılık</h3>
            </div>
          </div>
          <p class="energy-box-desc">
            Değişen tüm eski filtreleri ve atık yağı gözünüzün önünde çıkarıyor, işlem öncesinde net ve şeffaf fiyat bilgisiyle sürpriz maliyetleri ortadan kaldırıyoruz.
          </p>
        </div>

        <!-- Kutu 3 -->
        <div class="energy-box">
          <div class="energy-box-header">
            <div class="energy-box-num">3</div>
            <div class="energy-box-titles">
              <h2>Sürdürülebilirlik</h2>
              <h3>Yeşil Otomotiv & MoYDeN</h3>
            </div>
          </div>
          <p class="energy-box-desc">
            Çevre, Şehircilik ve İklim Değişikliği Bakanlığı MoYDeN sistemine tam uyumlu atık yağ yönetimiyle İzmir'in doğasını koruyor, geri dönüşümü destekliyoruz.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       HİZMETLERİMİZ / NELER YAPIYORUZ? (6'LI KUTU DÜZENİ)
       ========================================================================= -->
  <section class="section-services">
    <div class="container">
      
      <div class="services-header">
        <span class="section-tag">HİZMETLERİMİZ</span>
        <h2 class="section-title">Neler yapıyoruz?</h2>
        <p style="color: var(--asm-text-muted); font-size: 15px; max-width: 650px; margin: 0 auto;">
          Aracınızın motor ömrünü uzatan, üretici standartlarına tam uyumlu profesyonel bakım çözümlerimiz
        </p>
      </div>

      <div class="services-grid">
        
        <!-- Kart 1 -->
        <div class="service-card">
          <div class="service-card-header">
            <div class="service-card-num">1</div>
            <div class="service-card-title">
              <h2>Motor Yağı<br/>Değişimi</h2>
            </div>
          </div>
          <div class="service-card-img-wrap">
            <img src="/images/oil-fill-close.webp" alt="Motor Yağı Değişimi İzmir" width="600" height="350" loading="lazy" />
          </div>
          <p class="service-card-desc">
            0W-20, 5W-30 ve 5W-40 tam sentetik motor yağları ile karterden sıcak tahliye veya vakumlu profesyonel motor yağı değişimi.
          </p>
          <a href="/motor-yagi-degisimi/" class="arrow_link">Detaylı Bilgi →</a>
        </div>

        <!-- Kart 2 -->
        <div class="service-card">
          <div class="service-card-header">
            <div class="service-card-num">2</div>
            <div class="service-card-title">
              <h2>Yağ Filtresi<br/>Değişimi</h2>
            </div>
          </div>
          <div class="service-card-img-wrap">
            <img src="/images/service-oil-filter.webp" alt="Yağ Filtresi Değişimi İzmir" width="600" height="350" loading="lazy" />
          </div>
          <p class="service-card-desc">
            Her yağ değişiminde mikron düzeyinde süzme sağlayan OEM onaylı yağ filtrelerinin tork anahtarıyla garantili montajı.
          </p>
          <a href="/yag-filtresi-degisimi/" class="arrow_link">Detaylı Bilgi →</a>
        </div>

        <!-- Kart 3 -->
        <div class="service-card">
          <div class="service-card-header">
            <div class="service-card-num">3</div>
            <div class="service-card-title">
              <h2>Periyodik Araç<br/>Bakım Paketi</h2>
            </div>
          </div>
          <div class="service-card-img-wrap">
            <img src="/images/service-engine-bay.webp" alt="Periyodik Bakım İzmir" width="600" height="350" loading="lazy" />
          </div>
          <p class="service-card-desc">
            10.000 ve 15.000 km periyodik bakımlarında yağ, 4 filtre, bujiler, kayış kontrolü ve 30 nokta mekanik güvenlik analizi.
          </p>
          <a href="/periyodik-bakim/" class="arrow_link">Detaylı Bilgi →</a>
        </div>

        <!-- Kart 4 -->
        <div class="service-card">
          <div class="service-card-header">
            <div class="service-card-num">4</div>
            <div class="service-card-title">
              <h2>Hava & Polen<br/>Filtresi</h2>
            </div>
          </div>
          <div class="service-card-img-wrap">
            <img src="/images/service-air-cabin-filter.webp" alt="Hava ve Polen Filtresi Değişimi" width="600" height="350" loading="lazy" />
          </div>
          <p class="service-card-desc">
            Motorun optimum hava debisini sağlayan hava filtresi ve kabin içi alerjenleri önleyen aktif karbonlu polen filtre değişimi.
          </p>
          <a href="/motor-yagi-degisimi/" class="arrow_link">Detaylı Bilgi →</a>
        </div>

        <!-- Kart 5 -->
        <div class="service-card">
          <div class="service-card-header">
            <div class="service-card-num">5</div>
            <div class="service-card-title">
              <h2>Fren Hidroliği<br/>& Sıvı Bakımı</h2>
            </div>
          </div>
          <div class="service-card-img-wrap">
            <img src="/images/brake-fluid-test.webp" alt="Fren Hidroliği ve Sıvı Kontrolleri" width="600" height="350" loading="lazy" />
          </div>
          <p class="service-card-desc">
            Elektronik cihazla fren hidroliği kaynama ve nem testi, antifriz refraktometre ölçümü, direksiyon ve cam suyu tamamlama.
          </p>
          <a href="/periyodik-bakim/" class="arrow_link">Detaylı Bilgi →</a>
        </div>

        <!-- Kart 6 -->
        <div class="service-card">
          <div class="service-card-header">
            <div class="service-card-num">6</div>
            <div class="service-card-title">
              <h2>Ticari Araç<br/>& Filo Bakımı</h2>
            </div>
          </div>
          <div class="service-card-img-wrap">
            <img src="/images/service-commercial-fleet.webp" alt="Ticari Araç Filo Bakımı İzmir" width="600" height="350" loading="lazy" />
          </div>
          <p class="service-card-desc">
            Kurye, servis ve nakliye filoları için minimum yatış süresi, seri yağ bakımı, kurumsal faturalama ve periyodik takip kaydı.
          </p>
          <a href="/motor-yagi-degisimi/" class="arrow_link">Detaylı Bilgi →</a>
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       ARAÇ & MODEL ÖZEL BAKIM BLOKLARI
       ========================================================================= -->
  <section class="section-vehicle-brands">
    <div class="container">
      <div style="text-align: center; margin-bottom: 35px;">
        <span class="section-tag">ARAÇ GRUBU UZMANLIĞI</span>
        <h2 class="section-title">Ticari ve Binek Araçlarınızda Güvenilir İş Ortağınız</h2>
      </div>

      <div class="brands-grid">
        
        <div class="brand-card">
          <h4>ÖZEL BAKIM</h4>
          <h2>Fiat Ducato & Doblo</h2>
          <p>MultiJet motorlara özel 0W-30 ve 5W-30 DPF uyumlu motor yağı ve ağır hizmet filtre bakımı.</p>
        </div>

        <div class="brand-card">
          <h4>ÖZEL BAKIM</h4>
          <h2>Renault Master & Trafic</h2>
          <p>dCi motor üretici normlarına (RN0720, RN17) uygun partikül filtre korumalı sentetik yağ servisi.</p>
        </div>

        <div class="brand-card">
          <h4>ÖZEL BAKIM</h4>
          <h2>Ford Transit & Custom</h2>
          <p>EcoBlue motorlara özel WSS-M2C950-A spesifikasyonlu motor yağı ve tam periyodik filtre değişimi.</p>
        </div>

        <div class="brand-card">
          <h4>BİNEK GRUP</h4>
          <h2>Tüm Binek Otomobiller</h2>
          <p>Volkswagen, Renault, Fiat, Ford, Toyota, Hyundai ve tüm markalara özel OEM onaylı yağ bakımı.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       GOOGLE HARİTALAR 54 MÜŞTERİ YORUMU (HAREKETLİ KAYAN BANT)
       ========================================================================= -->
  <section class="reviews-ticker-section">
    <div class="container" style="margin-bottom: 25px; text-align: center;">
      <span class="section-tag">DOĞRULANMIŞ MÜŞTERİ DENEYİMLERİ</span>
      <h2 class="section-title" style="margin-bottom: 12px;">Google Haritalar Müşteri Değerlendirmeleri</h2>
      <div class="reviews-badge-google">
