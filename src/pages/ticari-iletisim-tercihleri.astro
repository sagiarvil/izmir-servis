---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/business';
import { seoRegistry } from '../seo/registry';

const seo = seoRegistry['/ticari-iletisim-tercihleri/'];
---

<BaseLayout 
  title={seo.title} 
  description={seo.description}
  canonicalPath="/ticari-iletisim-tercihleri/"
>
  <div class="page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Sayfa Konumu">
        <a href="/">Anasayfa</a>
        <span>/</span>
        <span class="current">Ticari İletişim Tercihleri</span>
      </nav>
      <h1 class="page-title">{seo.heading}</h1>
    </div>
  </div>

  <section class="section">
    <div class="container legal-body">
      <h2>İletişim Tercihleriniz ve İzin Yönetimi</h2>
      <p>
        ASM Auto olarak, onayınız olmaksızın pazarlama amaçlı SMS, arama veya ticari elektronik ileti göndermiyoruz. Servis randevusu bilgilendirmesi haricinde bakım hatırlatması almak istemiyorsanız tercihinizi dilediğiniz zaman güncelleyebilirsiniz.
      </p>
      <p>
        İletişim izinlerinizi iptal etmek veya güncellemek için <strong>{business.email}</strong> adresimize e-posta gönderebilir veya <strong>{business.phoneDisplay}</strong> numaralı telefonumuzdan müşteri temsilcimize bildirebilirsiniz.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #16212C 0%, #0F1722 100%);
    color: #FFFFFF;
    padding: 40px 0;
    border-bottom: 2px solid var(--accent);
  }
  .breadcrumb {
    display: flex;
    gap: 8px;
    font-size: 13px;
    color: #94A3B8;
    margin-bottom: 12px;
  }
  .breadcrumb a {
    color: #CBD5E1;
  }
  .breadcrumb .current {
    color: #FFA573;
    font-weight: 600;
  }
  .page-title {
    color: #FFFFFF;
    font-size: 30px;
  }
  .legal-body {
    max-width: 800px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
  }
  .legal-body h2 {
    font-size: 20px;
    color: var(--ink);
    margin-top: 24px;
    margin-bottom: 10px;
  }
</style>
