---
import Layout from '../layouts/Layout.astro';
import { business } from '../data/business';
---

<Layout
  title="Hakkımızda | Murat Asım & ASM Auto İzmir Yağ Servisi"
  description="Murat Asım ustalığıyla 25 yıldır İzmir 6. Sanayi Sitesi'nde aynı adreste motor yağı değişimi, motor revizyonu ve periyodik araç bakımı sunan uzman servis ASM Auto."
>
  <div style="background-color: var(--amcam-dark); color: #fff; padding: 45px 0 50px; border-bottom: 3px solid var(--amcam-red);">
    <div class="container">
      <span class="section-tag" style="color: #ff4d4f;">KURUMSAL KİMLİK & USTA DENEYİMİ</span>
      <h1 style="font-size: 36px; color: #fff; text-transform: uppercase;">Hakkımızda</h1>
      <p style="color: #cbd5e1; font-size: 16px; margin-top: 8px;">25 yıldır İzmir 6. Sanayi Sitesi'nde aynı adreste, otomotiv motoruna adanmış çeyrek asırlık zanaat.</p>
    </div>
  </div>

  <section class="section-about">
    <div class="container">
      <div class="about-grid">
        <div class="about-visual">
          <div class="about-image-card" style="border: 3px solid #1a202c;">
            <img src="/images/about-murat-asim.webp" alt="Murat Asım ve ASM Auto Motor Yapımı" width="600" height="600" style="width: 100%; height: auto; object-fit: cover;" />
            <div class="about-experience-badge" style="background-color: var(--amcam-red); bottom: 15px; right: 15px;">
              <div class="num">25</div>
              <div class="txt">YILDIR AYNI<br/>ADRESTE</div>
            </div>
          </div>
        </div>

        <div class="about-text-content">
          <span class="section-tag">USTALIK VE TEKNİK DİSİPLİN</span>
          <h2 class="section-title">Biz kimiz</h2>
          <h3 class="section-subtitle">25 Yıllık Ustalık Tecrübesiyle Murat Asım</h3>
          
          <p class="about-lead">
            ASM Auto, motor yağı değişimini yalnızca 'yağ akıtıp yeni yağ doldurmak' olarak değil; bir motorun ömrünü, yakıt tüketimini ve mekanik sıhhatini belirleyen en kritik koruma adımı olarak görür.
          </p>

          <p class="about-text">
            Kurucumuz <strong>Murat Asım</strong>, 25 yıldır İzmir Gaziemir / Karabağlar 6. Sanayi Sitesi'ndeki aynı adreste hizmet vermektedir. Sıfırdan motor rektifiyesi, yüksek performanslı V8 motor projeleri, klasik otomobil restorasyonu ve binek/ticari araçların üretici spesifikasyonuna uygun periyodik bakımını bizzat yürütmektedir.
          </p>

          <ul class="about-checklist">
            <li>✓ 25 Yıldır Aynı Sabit Adres (6. Sanayi Sitesi)</li>
            <li>✓ Orijinal & OEM Lisanslı Filtreler</li>
            <li>✓ Tam Sentetik Üretici Onaylı Yağlar</li>
            <li>✓ MoYDeN Çevre Bakanlığı İzinli Bertaraf</li>
          </ul>

          <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 20px;">
            <a href="/uzmanlik-ve-eeat/" class="header-cta-btn">
              Google E-E-A-T Raporunu İncele →
            </a>
            <a href="/iletisim/" class="header-cta-btn" style="background-color: var(--amcam-dark); border-color: #333;">
              İletişim & Yol Tarifi →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
