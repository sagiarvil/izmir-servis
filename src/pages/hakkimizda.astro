---
import Layout from '../layouts/Layout.astro';
import { business } from '../data/business';
---

<Layout
  title="Hakkımızda | ASM Auto İzmir Yağ Değişim Servisi"
  description="İzmir'de 35 yıllık mesleki tecrübeyle motor yağı değişimi ve periyodik araç bakımı sunan uzman servis ASM Auto."
>
  <div style="background-color: var(--amcam-dark); color: #fff; padding: 45px 0 50px; border-bottom: 3px solid var(--amcam-red);">
    <div class="container">
      <span class="section-tag" style="color: #ff4d4f;">KURUMSAL</span>
      <h1 style="font-size: 36px; color: #fff; text-transform: uppercase;">Hakkımızda</h1>
      <p style="color: #cbd5e1; font-size: 16px; margin-top: 8px;">35 yıllık mesleki ustalık tecrübesiyle İzmir'in güvenilir yağ değişim merkezi.</p>
    </div>
  </div>

  <section class="section-about">
    <div class="container">
      <div class="about-grid">
        <div class="about-visual">
          <div class="about-image-card">
            <img src="/images/about-workshop.webp" alt="ASM Auto Servis Atölyesi" width="600" height="350" />
            <div class="about-experience-badge">
              <div class="num">35</div>
              <div class="txt">Yıllık Ustalık<br/>Tecrübesi</div>
            </div>
          </div>
        </div>

        <div class="about-text-content">
          <span class="section-tag">USTALIK VE TEKNİK DİSİPLİN</span>
          <h2 class="section-title">Biz kimiz</h2>
          <h3 class="section-subtitle">Motor Bakımında Ezbere Değil, Üretici Standardına Bağlıyız</h3>
          
          <p class="about-lead">
            ASM Auto, motor yağı değişimini yalnızca 'yağ akıtıp yeni yağ koymak' olarak görmez. Motor üreticisinin belirlediği viskozite, ACEA onayları ve OEM şartnamelerini titizlikle uygular.
          </p>

          <p class="about-text">
            İzmir Gaziemir ve Karabağlar kesişiminde yer alan 6. Sanayi Sitesi'ndeki servis noktamızda, binek araçlardan hafif ticari filolara kadar her marka otomobil için üretici spesifikasyonlarına uygun tam sentetik motor yağları ve orijinal filtreler kullanıyoruz.
          </p>

          <ul class="about-checklist">
            <li>✓ 35 Yıllık Ustalık Tecrübesi</li>
            <li>✓ Orijinal & OEM Lisanslı Filtreler</li>
            <li>✓ Tam Sentetik Üretici Onaylı Yağlar</li>
            <li>✓ MoYDeN Çevre Bakanlığı İzinli Bertaraf</li>
          </ul>

          <a href="/iletisim/" class="header-cta-btn">
            İletişim & Yol Tarifi →
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
