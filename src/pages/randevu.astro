---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationForm from '../components/LocationForm.astro';
import { seoRegistry } from '../seo/registry';
import { business } from '../data/business';

const seo = seoRegistry['/randevu/'];
---

<BaseLayout 
  title={seo.title} 
  description={seo.description}
  canonicalPath="/randevu/"
>
  <div class="page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Sayfa Konumu">
        <a href="/">Anasayfa</a>
        <span>/</span>
        <span class="current">Randevu Al</span>
      </nav>
      <h1 class="page-title">{seo.heading}</h1>
      <p class="page-intro">
        Aracınızın motor yağı değişimi ve periyodik bakım işlemlerini sıra beklemeden, planlı bir şekilde gerçekleştirmek için aşağıdaki formu doldurabilirsiniz.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="appointment-steps-banner">
        <div class="step-card">
          <div class="s-num">1</div>
          <div class="s-info">
            <strong>Bilgileri İletin</strong>
            <span>Araç modelinizi ve seçtiğiniz hizmeti formdan gönderin.</span>
          </div>
        </div>
        <div class="step-card">
          <div class="s-num">2</div>
          <div class="s-info">
            <strong>Teknik Onay</strong>
            <span>Ustamiz araç motor kodunu inceleyip uygun yağı belirler.</span>
          </div>
        </div>
        <div class="step-card">
          <div class="s-num">3</div>
          <div class="s-info">
            <strong>Hızlı Kabul</strong>
            <span>Teyit edilen saatte servise gelin, aynı gün teslim alın.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <LocationForm />
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #16212C 0%, #0F1722 100%);
    color: #FFFFFF;
    padding: 48px 0;
    border-bottom: 2px solid var(--accent);
  }
  .breadcrumb {
    display: flex;
    gap: 8px;
    font-size: 13px;
    color: #94A3B8;
    margin-bottom: 16px;
  }
  .breadcrumb a {
    color: #CBD5E1;
  }
  .breadcrumb .current {
    color: #FFA573;
    font-weight: 600;
  }
  .page-title {
    color: #FFFFFF;
    font-size: 32px;
    margin-bottom: 12px;
  }
  .page-intro {
    font-size: 16px;
    color: #94A3B8;
    max-width: 720px;
    line-height: 1.6;
  }
  .appointment-steps-banner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    background: var(--surface-soft);
    padding: 24px;
    border-radius: var(--radius-card);
    border: 1px solid var(--line);
  }
  .step-card {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .s-num {
    width: 44px;
    height: 44px;
    background-color: var(--accent);
    color: #FFFFFF;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 800;
    flex-shrink: 0;
  }
  .s-info strong {
    display: block;
    font-size: 15px;
    color: var(--ink);
    margin-bottom: 2px;
  }
  .s-info span {
    font-size: 13px;
    color: var(--muted);
  }
  @media (min-width: 768px) {
    .appointment-steps-banner {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
