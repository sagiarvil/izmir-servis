---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import LocationForm from '../components/LocationForm.astro';
import { seoRegistry } from '../seo/registry';
import { services } from '../data/services';
import { business } from '../data/business';

const seo = seoRegistry['/motor-yagi-degisimi/'];
const service = services.find(s => s.id === 'motor-yagi')!;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "İzmir Motor Yağı Değişimi",
  "serviceType": "Motor Yağı Değişimi",
  "provider": {
    "@type": "AutoRepair",
    "name": business.name,
    "telephone": business.phoneE164,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": business.address.street,
      "addressLocality": business.address.district,
      "addressRegion": "İzmir",
      "addressCountry": "TR"
    }
  },
  "areaServed": {
    "@type": "City",
    "name": "İzmir"
  },
  "description": service.fullDesc
};
---

<BaseLayout 
  title={seo.title} 
  description={seo.description}
  canonicalPath="/motor-yagi-degisimi/"
  schemaJson={serviceSchema}
>
  <div class="page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Sayfa Konumu">
        <a href="/">Anasayfa</a>
        <span>/</span>
        <a href="/#hizmetler">Hizmetlerimiz</a>
        <span>/</span>
        <span class="current">Motor Yağı Değişimi</span>
      </nav>
      <h1 class="page-title">{seo.heading}</h1>
      <p class="page-intro">
        Aracınızın fabrika onaylı tam sentetik motor yağı değişimi, karter temizliği ve uzman teknisyen kontrolü ile motor sağlığınızı koruyoruz.
      </p>
    </div>
  </div>

  <section class="section service-content-section">
    <div class="container content-grid">
      <div class="main-body">
        <h2>Motor Yağı Değişimi Neden Hayati Önem Taşır?</h2>
        <p>
          Motor yağı, motorun içinde hareket eden yüzlerce metal parçanın birbiriyle temas ederek aşınmasını engelleyen koruyucu bir film tabakası oluşturur. Zamanla yüksek ısı, yanma gazları ve yakıt partikülleri yağın kimyasal bileşimini bozar ve akışkanlık özelliğini yitirmesine sebep olur.
        </p>
        
        <h3>ASM Auto'da Yağ Değişimi Nasıl Uygulanır?</h3>
        <ul class="process-checklist">
          <li><strong>1. Araç Bilgisayarı ve Motor Kodu Kontrolü:</strong> Aracın fabrika kılavuzunda belirtilen viskozite (0W-20, 5W-30 vb.) ve OEM onay standardı kontrol edilir.</li>
          <li><strong>2. Eski Yağın Boşaltılması:</strong> Karter tapası açılarak motorun sıcaklığında eski kirli yağ ve karter dibindeki tortular tamamen tahliye edilir.</li>
          <li><strong>3. Karter Tapası ve Pul Yenilemesi:</strong> Karter tapa pulu sızdırmazlık riskine karşı kontrol edilir veya yenilenir; fabrika torkuyla sıkılır.</li>
          <li><strong>4. Yeni Yağın Doldurulması ve Seviye Testi:</strong> Üretici onaylı tam sentetik taze motor yağı hacmine uygun şekilde doldurulur ve motor çalıştırılarak yağ basıncı ölçülür.</li>
        </ul>

        <h3>Kullandığımız Yağ Standartları ve Viskoziteler</h3>
        <div class="specs-pill-container">
          {service.specs.map((spec) => (
            <span class="spec-pill">{spec}</span>
          ))}
        </div>
      </div>

      <aside class="sidebar-box">
        <div class="service-summary-card">
          <h4>Hizmet Özeti</h4>
          <dl class="summary-list">
            <dt>Tahmini Süre:</dt>
            <dd>{service.estimatedDuration}</dd>
            <dt>Uygulanan Bölge:</dt>
            <dd>İzmir (Gaziemir / Karabağlar)</dd>
            <dt>Kullanılan Yağlar:</dt>
            <dd>Üretici Onaylı Tam Sentetik</dd>
            <dt>Garanti / Kayıt:</dt>
            <dd>Servis Bakım Kartı Verilir</dd>
          </dl>
          <a href="/randevu/" class="btn btn-primary" style="width: 100%; margin-top: 16px;">
            Yağ Değişimi Randevusu Al
          </a>
          <a href={`tel:${business.phoneE164}`} class="btn btn-outline" style="width: 100%; margin-top: 8px;">
            Hemen Ara: {business.phoneDisplay}
          </a>
        </div>
      </aside>
    </div>
  </section>

  <CtaBanner />
  <LocationForm />
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #16212C 0%, #0F1722 100%);
    color: #FFFFFF;
    padding: 48px 0;
    border-bottom: 2px solid var(--accent);
  }
  .breadcrumb {
    display: flex;
    gap: 8px;
    font-size: 13px;
    color: #94A3B8;
    margin-bottom: 16px;
  }
  .breadcrumb a {
    color: #CBD5E1;
  }
  .breadcrumb .current {
    color: #FFA573;
    font-weight: 600;
  }
  .page-title {
    color: #FFFFFF;
    font-size: 32px;
    margin-bottom: 12px;
  }
  .page-intro {
    font-size: 16px;
    color: #94A3B8;
    max-width: 720px;
    line-height: 1.6;
  }
  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .main-body h2 {
    font-size: 24px;
    margin-bottom: 14px;
    margin-top: 24px;
  }
  .main-body h3 {
    font-size: 18px;
    margin-top: 24px;
    margin-bottom: 12px;
  }
  .main-body p {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 16px;
  }
  .process-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
  }
  .process-checklist li {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink);
    background: var(--surface-soft);
    padding: 12px 16px;
    border-radius: 8px;
    border-left: 3px solid var(--accent);
  }
  .specs-pill-container {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
  }
  .spec-pill {
    background-color: var(--accent-soft);
    color: var(--accent-text);
    border: 1px solid rgba(216, 92, 32, 0.2);
    padding: 6px 14px;
    border-radius: 20px;
    font-weight: 700;
    font-size: 13px;
  }
  .sidebar-box {
    align-self: start;
  }
  .service-summary-card {
    background-color: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }
  .service-summary-card h4 {
    font-size: 18px;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }
  .summary-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    font-size: 13px;
  }
  .summary-list dt {
    color: var(--muted);
    font-weight: 600;
  }
  .summary-list dd {
    color: var(--ink);
    font-weight: 700;
  }
  @media (min-width: 992px) {
    .content-grid {
      grid-template-columns: 1.2fr 0.8fr;
    }
    .page-title {
      font-size: 40px;
    }
  }
</style>
