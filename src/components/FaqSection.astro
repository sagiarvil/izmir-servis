---
export interface FaqItem {
  q: string;
  a: string;
}

const defaultFaqs: FaqItem[] = [
  {
    q: "Motor yağı kaç kilometrede veya ne kadar sürede bir değişmelidir?",
    a: "Günümüz modern binek ve hafif ticari araçlarında motor yağı değişim aralığı araç üreticisinin teknik kılavuzuna göre genellikle 10.000 km ile 15.000 km arasında veya yılda 1 kez (hangisi önce dolarsa) yapılmalıdır. Şehir içi yoğun dur-kalk trafikte çalışan araçlarda yağın kimyasal özellikleri daha hızlı yıprandığından yıllık bakım kritik önem taşır."
  },
  {
    q: "Aracıma sadece 5W-30 demek yağ seçimi için yeterli midir?",
    a: "Hayır, kesinlikle yetmez. 5W-30 yalnızca yağın soğuk ve sıcak vizkozite akışkanlık sınıfını gösterir. Asıl belirleyici olan araç üreticisinin onay standartlarıdır (Örn: Volkswagen VW 504.00/507.00, Renault RN 0720, BMW Longlife-04, Mercedes-Benz MB 229.51 vb.). ASM Auto'da aracınızın tam fabrika spesifikasyonuna uygun yağ kullanılır."
  },
  {
    q: "Her yağ değişiminde yağ filtresi de mutlaka değişmeli midir?",
    a: "Evet. Yağ filtresi, motorun içinde biriken mikroskobik metal çapaklarını ve karbon partiküllerini tutar. Eski filtrenin içinde yaklaşık 0.3 - 0.5 litre kirli atık yağ kalır. Filtre değiştirilmezse yeni koyduğunuz temiz motor yağı ilk çalıştırmada kirlenir ve filtrenin bypass valfi açılarak süzülmemiş kirli yağın motora basılmasına sebep olabilir."
  },
  {
    q: "Motor yağı bakım süresi ne kadar sürer?",
    a: "ASM Auto'da standart motor yağı ve yağ filtresi değişimi ortalama 25 ile 40 dakika arasında tamamlanır. Hava ve polen filtrelerinin de dahil olduğu 15 nokta periyodik bakım işlemi ise ortalama 45 ile 60 dakika sürmektedir."
  },
  {
    q: "Yağ bakım ücreti neye göre belirlenir?",
    a: "Bakım maliyeti; aracınızın motorunun aldığı yağ litresi hacmine (3.5L, 4.5L, 6L vb.), kullanılan yağın tam sentetik üretici onay standardına ve aracın filtre grubu marka tercihlerine (Orijinal OEM veya kaliteli Bosch/Mann/Filtron) göre belirlenir. İşlem öncesi tahmini fiyat net olarak paylaşılır."
  },
  {
    q: "Randevu almak zorunlu mudur?",
    a: "Randevu zorunlu değildir ancak sıra beklemeden hızlı hizmet alabilmeniz adına online talep formu veya telefon/WhatsApp üzerinden randevu oluşturmanızı önemle tavsiye ederiz."
  }
];
---

<section class="section faq-section" id="sss">
  <div class="container">
    <div class="section-header">
      <span class="badge">BİLGİLENDİRME & REHBER</span>
      <h2 class="section-title">Sıkça Sorulan Sorular</h2>
      <p class="section-subtitle">
        Motor yağı değişimi ve araç bakım süreçlerine dair müşterilerimizin en çok merak ettiği teknik konular.
      </p>
    </div>

    <div class="faq-accordion-list">
      {defaultFaqs.map((faq, index) => (
        <details class="faq-item" open={index === 0}>
          <summary class="faq-question">
            <span>{faq.q}</span>
            <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="faq-answer">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section {
    background-color: var(--surface);
  }
  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 40px auto;
  }
  .section-title {
    font-size: 28px;
    margin-top: 14px;
    margin-bottom: 12px;
  }
  .section-subtitle {
    font-size: 15px;
    color: var(--muted);
  }
  .faq-accordion-list {
    max-width: 840px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .faq-item {
    background-color: var(--surface-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-button);
    padding: 16px 20px;
    transition: all 0.2s ease;
  }
  .faq-item[open] {
    border-color: var(--accent);
    background-color: var(--surface);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
  }
  .faq-question {
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .faq-question::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    width: 18px;
    height: 18px;
    color: var(--muted);
    transition: transform 0.2s;
    flex-shrink: 0;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
    color: var(--accent);
  }
  .faq-answer {
    padding-top: 12px;
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
    border-top: 1px dashed var(--line);
    margin-top: 12px;
  }
  @media (min-width: 992px) {
    .section-title {
      font-size: 34px;
    }
  }
</style>
