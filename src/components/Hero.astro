---
import { business } from '../data/business';
---

<section class="hero-section">
  <div class="hero-backdrop"></div>
  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>İZMİR'İN GÜVENİLİR MOTOR YAĞI & PERİYODİK BAKIM SERVİSİ</span>
      </div>
      
      <h1 class="hero-title">
        İzmir'de Motor Yağı Değişimi ve Profesyonel Periyodik Bakım
      </h1>
      
      <p class="hero-lead">
        35 yıllık mesleki tecrübe, aracınızın üretici standartlarına uygun orijinal filtreler ve onaylı tam sentetik motor yağlarıyla motorunuzun ömrünü uzatan yerel uzman servis.
      </p>

      <div class="hero-cta-group">
        <a href={`tel:${business.phoneE164}`} class="btn btn-primary hero-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-icon">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"></path>
          </svg>
          <span>Hemen Ara: {business.phoneDisplay}</span>
        </a>

        <a href={business.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp hero-btn">
          <svg viewBox="0 0 24 24" fill="currentColor" class="btn-icon">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 012.41 5.82c0 4.54-3.7 8.24-8.24 8.24-1.45 0-2.87-.38-4.12-1.1l-.3-.17-3.12.82.83-3.04-.19-.31a8.2 8.2 0 01-1.25-4.44c0-4.54 3.7-8.24 8.24-8.24m4.52 11.64c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.25-1.5-1.4-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.72 4.31 3.81.6.26 1.07.41 1.44.53.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.3z"></path>
          </svg>
          <span>WhatsApp'tan Danışın</span>
        </a>

        <a href="/randevu/" class="btn btn-outline-white hero-btn">
          <span>Servis Talebi Oluştur →</span>
        </a>
      </div>
    </div>

    <!-- Quick Features Strip (ASM Style) -->
    <div class="hero-features-grid">
      <div class="feature-card">
        <div class="feature-icon-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="feature-svg">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
          </svg>
        </div>
        <div class="feature-text">
          <strong>35 Yıllık Ustalık</strong>
          <span>Usta Murat Güvencesi</span>
        </div>
      </div>

      <div class="feature-card">
        <div class="feature-icon-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="feature-svg">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <div class="feature-text">
          <strong>Üretici Onaylı Yağ</strong>
          <span>ACEA / API Standartları</span>
        </div>
      </div>

      <div class="feature-card">
        <div class="feature-icon-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="feature-svg">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
        <div class="feature-text">
          <strong>Aynı Gün Hızlı Servis</strong>
          <span>25 - 45 Dk Teslimat</span>
        </div>
      </div>

      <div class="feature-card">
        <div class="feature-icon-box">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="feature-svg">
            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
        </div>
        <div class="feature-text">
          <strong>Şeffaf Bakım Kaydı</strong>
          <span>Tork & Sızdırmazlık Testi</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    background-color: #0E1721;
    background-image: radial-gradient(circle at 80% 20%, rgba(216, 92, 32, 0.15) 0%, transparent 50%),
                      linear-gradient(180deg, #121C27 0%, #0A1118 100%);
    color: #FFFFFF;
    padding-top: 64px;
    padding-bottom: 50px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }
  .hero-container {
    position: relative;
    z-index: 2;
  }
  .hero-content {
    max-width: 860px;
    margin-bottom: 48px;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(216, 92, 32, 0.15);
    border: 1px solid rgba(216, 92, 32, 0.35);
    color: #FFA573;
    padding: 6px 14px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .badge-dot {
    width: 8px;
    height: 8px;
    background-color: #D85C20;
    border-radius: 50%;
    box-shadow: 0 0 8px #D85C20;
  }
  .hero-title {
    font-size: 32px;
    line-height: 1.2;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
  }
  .hero-lead {
    font-size: 17px;
    line-height: 1.6;
    color: #94A3B8;
    margin-bottom: 32px;
    max-width: 760px;
  }
  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }
  .hero-btn {
    padding: 15px 26px;
    font-size: 15px;
  }
  .btn-icon {
    width: 18px;
    height: 18px;
  }
  .btn-whatsapp {
    background-color: #25D366;
    color: #FFFFFF;
  }
  .btn-whatsapp:hover {
    background-color: #20BA5A;
  }
  .btn-outline-white {
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #FFFFFF;
  }
  .btn-outline-white:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: #FFFFFF;
  }
  .hero-features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .feature-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 14px 18px;
    backdrop-filter: blur(8px);
  }
  .feature-icon-box {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: rgba(216, 92, 32, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #D85C20;
    flex-shrink: 0;
  }
  .feature-svg {
    width: 22px;
    height: 22px;
  }
  .feature-text {
    display: flex;
    flex-direction: column;
  }
  .feature-text strong {
    font-size: 14px;
    color: #F8FAFC;
    font-weight: 700;
  }
  .feature-text span {
    font-size: 12px;
    color: #94A3B8;
  }
  @media (min-width: 640px) {
    .hero-features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .hero-title {
      font-size: 46px;
    }
    .hero-features-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
