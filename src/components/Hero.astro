---
import { business } from '../data/business';
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge-wrap">
        <span class="badge">ASM AUTO · İZMİR YAĞ SERVİSİ</span>
        <span class="badge-sub">35 Yıllık Ustalık Deneyimi</span>
      </div>

      <h1 id="hero-title" class="hero-title">
        İzmir'de Motor Yağı Değişimi ve Periyodik Bakım
      </h1>

      <p class="hero-lead">
        Yağ değişimi yalnızca eski yağı boşaltmak değildir. Aracın motoruna uygun spesifikasyon, doğru filtre ve düzgün uygulama gerekir. ASM Auto'da bakım ihtiyacınızı araç bilgilerinize göre değerlendirelim.
      </p>

      <!-- Ana Aksiyon Butonları (Clegg Dönüşüm Mimarisinin Omurgası) -->
      <div class="hero-actions">
        <a href={`tel:${business.phoneE164}`} class="btn btn-primary hero-btn-main">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          Hemen Ara: {business.phoneDisplay}
        </a>

        <a href={business.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary hero-btn-whatsapp">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          WhatsApp'tan Sor
        </a>

        <a href="#servis-talebi" class="btn btn-outline hero-btn-schedule">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          Servis Talebi Oluştur
        </a>
      </div>

      <!-- Hızlı Hizmet Geçiş Etiketleri -->
      <div class="hero-quick-tags">
        <span class="quick-tags-title">Öncelikli Hizmetler:</span>
        <a href="/motor-yagi-degisimi/" class="quick-tag">Motor Yağı Değişimi</a>
        <a href="/yag-filtresi-degisimi/" class="quick-tag">Yağ Filtresi Değişimi</a>
        <a href="/periyodik-bakim/" class="quick-tag">Periyodik Bakım</a>
      </div>
    </div>

    <!-- Sağ Görsel & Teknik Güven Paneli -->
    <div class="hero-visual">
      <div class="visual-card">
        <div class="visual-logo-wrap">
          <img src="/images/logo.png" alt="İzmir Yağ Değişim Servisi Resmi Rozeti" width="480" height="320" class="hero-logo-img" />
        </div>
        
        <div class="trust-pill-grid">
          <div class="trust-pill">
            <span class="pill-icon">✓</span>
            <div class="pill-text">
              <strong>Motor Koduna Özel</strong>
              <small>Üretici Onaylı Yağ Normu</small>
            </div>
          </div>

          <div class="trust-pill">
            <span class="pill-icon">✓</span>
            <div class="pill-text">
              <strong>Sıcak Karter Tahliyesi</strong>
              <small>Tortu Bırakmayan Boşaltma</small>
            </div>
          </div>

          <div class="trust-pill">
            <span class="pill-icon">✓</span>
            <div class="pill-text">
              <strong>35 Yıllık Ustalık</strong>
              <small>Usta Murat Güvencesi</small>
            </div>
          </div>

          <div class="trust-pill">
            <span class="pill-icon">✓</span>
            <div class="pill-text">
              <strong>Tork Kontrollü</strong>
              <small>Sıfır Kaçak & Sızdırmazlık</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%);
    padding-top: 36px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 992px) {
    .hero-section {
      padding-top: 60px;
      padding-bottom: 72px;
    }
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: center;
  }

  @media (min-width: 992px) {
    .hero-container {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 48px;
    }
  }

  .hero-badge-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .badge-sub {
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
    background-color: var(--surface-muted);
    padding: 6px 12px;
    border-radius: var(--radius-badge);
  }

  .hero-title {
    font-size: 32px;
    line-height: 1.18;
    color: var(--ink);
    letter-spacing: -0.02em;
    margin-bottom: 18px;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 44px;
    }
  }

  @media (min-width: 1200px) {
    .hero-title {
      font-size: 48px;
    }
  }

  .hero-lead {
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
    margin-bottom: 28px;
    max-width: 620px;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 28px;
  }

  @media (min-width: 576px) {
    .hero-actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  .hero-btn-main {
    background-color: var(--accent);
    color: #FFFFFF;
    font-weight: 700;
  }

  .hero-btn-whatsapp {
    background-color: #128C7E;
    color: #FFFFFF;
    font-weight: 600;
  }
  .hero-btn-whatsapp:hover {
    background-color: #075E54;
  }

  .hero-btn-schedule {
    font-weight: 600;
  }

  .hero-quick-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .quick-tags-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
    margin-right: 4px;
  }

  .quick-tag {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    background-color: var(--surface-soft);
    padding: 6px 12px;
    border-radius: 20px;
    border: 1px solid var(--line);
    transition: all 0.2s;
  }
  .quick-tag:hover {
    border-color: var(--accent);
    color: var(--accent);
    background-color: #FFF;
  }

  /* Sağ Görsel Kartı */
  .visual-card {
    background: #FFFFFF;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: 24px;
    box-shadow: 0 10px 30px rgba(22, 33, 44, 0.06);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .visual-logo-wrap {
    width: 100%;
    max-width: 380px;
    margin-bottom: 20px;
    display: flex;
    justify-content: center;
  }

  .hero-logo-img {
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.08));
  }

  .trust-pill-grid {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }

  @media (min-width: 480px) {
    .trust-pill-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .trust-pill {
    display: flex;
    align-items: center;
    gap: 10px;
    background-color: var(--surface-soft);
    padding: 10px 14px;
    border-radius: 10px;
    text-align: left;
    border: 1px solid var(--line);
  }

  .pill-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: var(--success-bg);
    color: var(--success);
    font-weight: 800;
    font-size: 13px;
    flex-shrink: 0;
  }

  .pill-text strong {
    display: block;
    font-size: 13px;
    color: var(--ink);
    line-height: 1.2;
  }

  .pill-text small {
    display: block;
    font-size: 11px;
    color: var(--muted);
  }
</style>
