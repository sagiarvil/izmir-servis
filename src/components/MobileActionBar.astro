---
import { business } from '../data/business';
---

<!-- Mobilde Ekranın Altına Yapışık İki Aksiyonlu Çubuk (Hemen Ara + WhatsApp) -->
<aside class="mobile-action-bar" aria-label="Hızlı İletişim Çubuğu">
  <a href={`tel:${business.phoneE164}`} class="mobile-act-btn btn-call">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
    <span>Hemen Ara</span>
  </a>

  <a href={business.whatsappUrl} target="_blank" rel="noopener noreferrer" class="mobile-act-btn btn-wa">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
    <span>WhatsApp</span>
  </a>
</aside>

<style>
  .mobile-action-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 64px;
    background: #FFFFFF;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    padding: 8px 16px;
    padding-bottom: calc(8px + env(safe-area-inset-bottom, 0px));
    gap: 12px;
    z-index: 999;
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
  }

  @media (min-width: 768px) {
    .mobile-action-bar {
      display: none;
    }
  }

  .mobile-act-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    padding: 12px 14px;
    border-radius: var(--radius-button);
    min-height: 48px;
    transition: all 0.2s;
  }

  .btn-call {
    background-color: var(--accent);
    color: #FFFFFF;
  }

  .btn-wa {
    background-color: #128C7E;
    color: #FFFFFF;
  }
</style>
