---
import { business } from '../data/business';
---

<div class="top-bar">
  <div class="container top-bar-container">
    <div class="top-bar-left">
      <span class="info-item">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>{business.address.street}, {business.address.district} / İzmir</span>
      </span>
      <span class="info-item hide-mobile">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>Pzt - Cmt: {business.workingHours.weekdays}</span>
      </span>
    </div>
    <div class="top-bar-right">
      <a href={`tel:${business.phoneE164}`} class="contact-link" aria-label="Telefon ile ara">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"></path>
        </svg>
        <span>{business.phoneDisplay}</span>
      </a>
      <a href={business.whatsappUrl} target="_blank" rel="noopener noreferrer" class="contact-link whatsapp" aria-label="WhatsApp'tan yaz">
        <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 012.41 5.82c0 4.54-3.7 8.24-8.24 8.24-1.45 0-2.87-.38-4.12-1.1l-.3-.17-3.12.82.83-3.04-.19-.31a8.2 8.2 0 01-1.25-4.44c0-4.54 3.7-8.24 8.24-8.24m4.52 11.64c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.25-1.5-1.4-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.72 4.31 3.81.6.26 1.07.41 1.44.53.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.3z"></path>
        </svg>
        <span class="hide-mobile">WhatsApp</span>
      </a>
      <a href={business.social.instagramShop} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Instagram sayfamız">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  .top-bar {
    background-color: var(--surface-dark);
    color: #CBD5E1;
    font-size: 13px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .top-bar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 8px;
    padding-bottom: 8px;
  }
  .top-bar-left, .top-bar-right {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .info-item, .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: inherit;
    transition: color 0.2s;
  }
  .contact-link:hover, .social-link:hover {
    color: #FFFFFF;
  }
  .contact-link.whatsapp {
    color: #25D366;
  }
  .icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }
  @media (max-width: 767px) {
    .hide-mobile {
      display: none;
    }
  }
</style>
