---
import { business } from '../data/business';
---

<section class="cta-banner">
  <div class="container cta-container">
    <div class="cta-text">
      <span class="cta-mini">HIZLI SERVİS & RANDEVU</span>
      <h2 class="cta-heading">Aracınızın Yağ Bakım Vakti Geldi mi?</h2>
      <p class="cta-sub">
        Geciken motor yağı değişimi motorda aşırı aşınmaya ve yüksek yakıt tüketimine yol açar. Hemen uzman ekibimizle görüşün.
      </p>
    </div>
    <div class="cta-buttons">
      <a href={`tel:${business.phoneE164}`} class="btn btn-primary cta-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="cta-btn-icon">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"></path>
        </svg>
        <span>{business.phoneDisplay}</span>
      </a>
      <a href="/randevu/" class="btn btn-outline-white cta-btn">
        <span>Online Randevu Al →</span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    background: linear-gradient(135deg, #16212C 0%, #0F1722 100%);
    border-top: 2px solid var(--accent);
    color: #FFFFFF;
    padding: 56px 0;
  }
  .cta-container {
    display: flex;
    flex-direction: column;
    gap: 32px;
    align-items: center;
    justify-content: space-between;
    text-align: center;
  }
  .cta-mini {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #FFA573;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 8px;
  }
  .cta-heading {
    font-size: 28px;
    color: #FFFFFF;
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }
  .cta-sub {
    font-size: 15px;
    color: #94A3B8;
    max-width: 600px;
  }
  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
  }
  .cta-btn {
    padding: 16px 28px;
    font-size: 15px;
  }
  .cta-btn-icon {
    width: 18px;
    height: 18px;
  }
  .btn-outline-white {
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #FFFFFF;
  }
  .btn-outline-white:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: #FFFFFF;
  }
  @media (min-width: 992px) {
    .cta-container {
      flex-direction: row;
      text-align: left;
    }
    .cta-heading {
      font-size: 34px;
    }
  }
</style>
