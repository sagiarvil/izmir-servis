---
import { business } from '../data/business';
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-top">
      <!-- Marka Bilgisi -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-logo-link">
          <img src="/images/logo.png" alt="ASM İzmir Yağ Değişim Servisi Logo" width="160" height="54" class="footer-logo" />
        </a>
        <p class="footer-tagline">
          {business.description}
        </p>
        <div class="footer-social">
          <a href={business.social.instagramShop} target="_blank" rel="noopener noreferrer" aria-label="ASM Auto Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href={business.social.instagramMaster} target="_blank" rel="noopener noreferrer" aria-label="Usta Murat Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </a>
        </div>
      </div>

      <!-- Hizmet Bağlantıları -->
      <div class="footer-col">
        <h4 class="footer-heading">Hizmetlerimiz</h4>
        <ul class="footer-links">
          <li><a href="/motor-yagi-degisimi/">Motor Yağı Değişimi</a></li>
          <li><a href="/yag-filtresi-degisimi/">Yağ Filtresi Değişimi</a></li>
          <li><a href="/periyodik-bakim/">Periyodik Bakım</a></li>
          <li><a href="/sikca-sorulan-sorular/">Araç Bakım Rehberi</a></li>
          <li><a href="/randevu/">Servis Randevusu</a></li>
        </ul>
      </div>

      <!-- Kurumsal & Yasal Bağlantılar -->
      <div class="footer-col">
        <h4 class="footer-heading">Kurumsal & Yasal</h4>
        <ul class="footer-links">
          <li><a href="/hakkimizda/">Hakkımızda & Usta Murat</a></li>
          <li><a href="/iletisim/">İletişim & Konum</a></li>
          <li><a href="/kvkk-aydinlatma/">KVKK Aydınlatma Metni</a></li>
          <li><a href="/gizlilik-ve-cerezler/">Gizlilik ve Çerezler</a></li>
          <li><a href="/ticari-iletisim-tercihleri/">İletişim Tercihleri</a></li>
        </ul>
      </div>

      <!-- İletişim & Çalışma Saatleri -->
      <div class="footer-col contact-col">
        <h4 class="footer-heading">İletişim & Saatler</h4>
        <p class="footer-contact-item">
          <strong>Adres:</strong> {business.address.fullAddress}
        </p>
        <p class="footer-contact-item">
          <strong>Telefon:</strong> <a href={`tel:${business.phoneE164}`}>{business.phoneDisplay}</a>
        </p>
        <p class="footer-contact-item">
          <strong>Pzt - Cts:</strong> {business.workingHours.weekdays}
        </p>
        <p class="footer-contact-item">
          <strong>Pazar:</strong> Kapalı
        </p>
      </div>
    </div>

    <!-- Alt Telif & Bildirim Bandı -->
    <div class="footer-bottom">
      <p class="copyright">
        © {new Date().getFullYear()} {business.legalName} · {business.serviceBrand}. Tüm hakları saklıdır.
      </p>
      <p class="disclaimer">
        Araç üretici marka isimleri (VW, Renault, Fiat vb.) yalnızca yedek parça ve yağ normu uyumluluğunu belirtmek için kullanılmıştır; yetkili servis bağı iddiası taşımaz.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--surface-dark);
    color: #94A3B8;
    font-size: 14px;
    padding-top: 56px;
    padding-bottom: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    margin-bottom: 48px;
  }

  @media (min-width: 576px) {
    .footer-top {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 992px) {
    .footer-top {
      grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
      gap: 40px;
    }
  }

  .footer-logo {
    height: 48px;
    width: auto;
    object-fit: contain;
    margin-bottom: 16px;
  }

  .footer-tagline {
    font-size: 13px;
    line-height: 1.6;
    margin-bottom: 20px;
    color: #CBD5E1;
  }

  .footer-social {
    display: flex;
    gap: 12px;
  }

  .footer-social a {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    transition: background 0.2s;
  }
  .footer-social a:hover {
    background: var(--accent);
  }

  .footer-heading {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 18px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    color: #94A3B8;
    transition: color 0.2s;
  }
  .footer-links a:hover {
    color: #FFFFFF;
  }

  .footer-contact-item {
    font-size: 13px;
    line-height: 1.6;
    margin-bottom: 8px;
  }

  .footer-contact-item strong {
    color: #FFFFFF;
  }

  .footer-contact-item a {
    color: var(--accent);
    font-weight: 700;
  }

  .footer-bottom {
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 12px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      text-align: left;
    }
  }

  .copyright {
    color: #CBD5E1;
  }

  .disclaimer {
    color: #64748B;
    line-height: 1.4;
  }
</style>
