---
import { business } from '../data/business';
import { services } from '../data/services';
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Col 1: Brand Info -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-logo-link" aria-label="ASM Auto Anasayfa">
          <img 
            src="/images/logo.png" 
            alt="İzmir Yağ Değişim Servisi - ASM Auto" 
            class="footer-logo"
            width="200"
            height="66"
            loading="lazy"
          />
        </a>
        <p class="footer-desc">
          ASM Auto, İzmir'de motor yağı ve periyodik araç bakımına odaklanan, 35 yıllık mesleki ustalık tecrübesiyle çalışan bağımsız özel bakım servisidir.
        </p>
        <div class="footer-social-links">
          <a href={business.social.instagramShop} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="ASM Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a href={business.whatsappUrl} target="_blank" rel="noopener noreferrer" class="social-icon whatsapp" aria-label="WhatsApp Hattı">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 012.41 5.82c0 4.54-3.7 8.24-8.24 8.24-1.45 0-2.87-.38-4.12-1.1l-.3-.17-3.12.82.83-3.04-.19-.31a8.2 8.2 0 01-1.25-4.44c0-4.54 3.7-8.24 8.24-8.24m4.52 11.64c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.25-1.5-1.4-1.75-.14-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.72 4.31 3.81.6.26 1.07.41 1.44.53.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.3z"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Hizmetlerimiz -->
      <div class="footer-col">
        <h4 class="footer-title">Hizmetlerimiz</h4>
        <ul class="footer-links">
          {services.map((s) => (
            <li>
              <a href={`/${s.slug}/`}>{s.title}</a>
            </li>
          ))}
          <li><a href="/randevu/">Servis Randevusu Al</a></li>
        </ul>
      </div>

      <!-- Col 3: Hızlı Menü -->
      <div class="footer-col">
        <h4 class="footer-title">Kurumsal</h4>
        <ul class="footer-links">
          <li><a href="/">Anasayfa</a></li>
          <li><a href="/hakkimizda/">Hakkımızda & Usta Murat</a></li>
          <li><a href="/sikca-sorulan-sorular/">Sıkça Sorulan Sorular</a></li>
          <li><a href="/iletisim/">İletişim & Yol Tarifi</a></li>
          <li><a href="/kvkk-aydinlatma/">KVKK Aydınlatma Metni</a></li>
          <li><a href="/gizlilik-ve-cerezler/">Gizlilik & Çerez Politikası</a></li>
        </ul>
      </div>

      <!-- Col 4: İletişim Bilgileri -->
      <div class="footer-col">
        <h4 class="footer-title">Servis İletişim</h4>
        <p class="footer-contact-p">
          <strong>Adres:</strong><br />
          {business.address.fullAddress}
        </p>
        <p class="footer-contact-p">
          <strong>Telefon:</strong><br />
          <a href={`tel:${business.phoneE164}`}>{business.phoneDisplay}</a>
        </p>
        <p class="footer-contact-p">
          <strong>Çalışma Saatleri:</strong><br />
          Pzt - Cmt: {business.workingHours.weekdays}
        </p>
      </div>
    </div>

    <!-- KURUMSAL ÇAPRAZ PENETRASYON VE ANALİTİK KARAR DESTEK AĞI -->
    <div class="footer-partners-strip" style="border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 16px; margin-top: 20px; font-size: 11.5px; color: #64748b; line-height: 1.6;">
      <span style="color: #94a3b8; font-weight: 700;">Bağlı Karar Destek & Analitik Ağ Platformları:</span>
      <div style="display: flex; flex-wrap: wrap; gap: 8px 14px; margin-top: 6px;">
        <a href="https://drfin.com.tr" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: none;" title="Kurumsal Finansal Analiz">drfin.com.tr</a> •
        <a href="https://excelarsiv.com" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: none;" title="Karar Modelleri & Arşiv">excelarsiv.com</a> •
        <a href="https://skdmhesapla.com" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: none;" title="SKDM Emisyon Hesaplama">skdmhesapla.com</a> •
        <a href="https://karbonfiyat.com" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: none;" title="Yeşil Dönüşüm & MoYDeN">karbonfiyat.com</a> •
        <a href="https://inversioncore.com" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: none;" title="Sistem Mimari Modelleri">inversioncore.com</a> •
        <a href="https://belginkuyumculuk.com" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: none;" title="Değerleme Standartları">belginkuyumculuk.com</a> •
        <a href="https://saatchi.com.tr" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: none;" title="Tasarım Mühendisliği">saatchi.com.tr</a> •
        <a href="https://dilekceyazdir.com.tr" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: none;" title="Tüketici Hakları Rehberi">dilekceyazdir.com.tr</a> •
        <a href="https://htmlandhtml.com" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: none;" title="Semantik Web Standartları">htmlandhtml.com</a> •
        <a href="https://degerlet.com" target="_blank" rel="noopener noreferrer" style="color: #94a3b8; text-decoration: none;" title="Araç & Varlık Değerleme">degerlet.com</a>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="copyright">
        © {new Date().getFullYear()} {business.name}. Tüm hakları saklıdır.
      </p>
      <div class="legal-links">
        <a href="/kvkk-aydinlatma/">KVKK</a>
        <a href="/gizlilik-ve-cerezler/">Gizlilik</a>
        <a href="/ticari-iletisim-tercihleri/">İletişim Tercihleri</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #121C27;
    color: #94A3B8;
    padding-top: 64px;
    padding-bottom: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    margin-bottom: 48px;
  }
  .footer-logo-link {
    display: inline-block;
    margin-bottom: 16px;
  }
  .footer-logo {
    height: 54px;
    width: auto;
    object-fit: contain;
  }
  .footer-desc {
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 20px;
    color: #94A3B8;
  }
  .footer-social-links {
    display: flex;
    gap: 12px;
  }
  .social-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    transition: background 0.2s, color 0.2s;
  }
  .social-icon:hover {
    background: var(--accent);
    color: #FFFFFF;
  }
  .social-icon.whatsapp:hover {
    background: #25D366;
  }
  .social-icon svg {
    width: 18px;
    height: 18px;
  }
  .footer-title {
    color: #FFFFFF;
    font-size: 16px;
    margin-bottom: 18px;
    letter-spacing: -0.01em;
  }
  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-links a {
    color: #94A3B8;
    font-size: 14px;
    transition: color 0.2s;
  }
  .footer-links a:hover {
    color: #FFFFFF;
  }
  .footer-contact-p {
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 12px;
  }
  .footer-contact-p strong {
    color: #F8FAFC;
  }
  .footer-contact-p a {
    color: var(--accent);
    font-weight: 600;
  }
  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: center;
    justify-content: space-between;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 13px;
  }
  .copyright {
    color: #64748B;
  }
  .legal-links {
    display: flex;
    gap: 18px;
  }
  .legal-links a {
    color: #64748B;
    transition: color 0.2s;
  }
  .legal-links a:hover {
    color: #94A3B8;
  }
  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 992px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    }
    .footer-bottom {
      flex-direction: row;
    }
  }
</style>
